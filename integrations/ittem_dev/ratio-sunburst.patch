+"""Selected output ratio; geometry stays owned by the image module."""
+from typing import Literal
+
+ImageSize = Literal["3:4", "4:5", "9:16"]
+
+
+def image_size(snapshot: dict) -> ImageSize:
+    value = snapshot.get("image_size", "4:5")
+    if value not in ("3:4", "4:5", "9:16"):
+        raise ValueError("Unsupported image ratio")
+    return value
+
+
+def image_profile(snapshot: dict):
+    from src.image_generation.layout_profiles import get_layout
+    ratio = image_size(snapshot)
+    # The current UI has one combined story/reels choice. Use existing Story B;
+    # a separate placement selector is deliberately outside this ratio repair.
+    return get_layout(ratio, "story" if ratio == "9:16" else "feed")
