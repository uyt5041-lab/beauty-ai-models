+"""Local ratio repair: no external network or paid providers."""
+import json
+import socket
+import base64
+from email import policy
+from email.parser import BytesParser
+from pathlib import Path
+from PIL import Image
+import httpx
+
+import pytest
+from fastapi.testclient import TestClient
+
+from demo_staging.live.contracts import validate_input, digest, LiveGateError
+from demo_staging.live.store import LiveStore
+from src.text_generation.schemas import ProductInput
+from tests.demo_live.test_live_contracts import sample_input, assets
+from tests.demo_live.test_http_gateway import setup, login, photo
+from tests.demo_live.test_pipeline import prepare_service, FakeOwner, png
+from src.image_generation.backend_adapter import BackendGeneratedImage
+from hashlib import sha256
+
+
+@pytest.fixture(autouse=True)
+def no_network(monkeypatch):
+    def blocked(*args, **kwargs):
+        pytest.fail("No external connection is allowed in ratio tests")
+    monkeypatch.setattr(socket, "create_connection", blocked)
+    monkeypatch.setattr(socket.socket, "connect", blocked)
+
+
+def uploaded(client):
+    response = client.post("/api/v1/jobs", files=[
+        ("product_images", ("front.png", photo((120, 130, 140)), "image/png")),
+        ("product_images", ("side.png", photo((150, 160, 170)), "image/png")),
+    ], headers={"Origin": "http://testserver"})
+    assert response.status_code == 201, response.text
+    return response.json()["job_id"]
+
+
+@pytest.mark.parametrize("ratio", ["3:4", "4:5", "9:16"])
+def test_input_http_accepts_frontend_size_and_persists(tmp_path, ratio):
+    app, codes = setup(tmp_path)
+    with TestClient(app) as client:
+        login(client, codes["alice"])
+        jid = uploaded(client)
+        payload = {**sample_input(), "image_size": ratio}
+        response = client.post(f"/demo/api/live/jobs/{jid}/input", json=payload,
+                               headers={"Origin": "http://testserver"})
+        assert response.status_code == 200, response.text
+        assert response.json()["image_size"] == ratio
+        assert client.get(f"/demo/api/live/jobs/{jid}").json()["image_size"] == ratio
+        stored = app.state.live_pipeline.state.get("alice", jid)
+        assert json.loads(stored["input_json"]).get("image_size", "4:5") == ratio
+        assert stored["state"] == "INPUT_STORED"  # No analysis/generation dispatched.
+
+
+@pytest.mark.parametrize("ratio", ["1:1", "1152x1440", "", None, True, ["4:5"]])
+def test_input_http_rejects_invalid_ratio(tmp_path, ratio):
+    app, codes = setup(tmp_path)
+    with TestClient(app) as client:
+        login(client, codes["alice"])
+        jid = uploaded(client)
+        response = client.post(f"/demo/api/live/jobs/{jid}/input",
+                               json={**sample_input(), "image_size": ratio},
+                               headers={"Origin": "http://testserver"})
+        assert response.status_code == 422
+
+
+def test_input_legacy_and_explicit_default_preserve_exact_snapshot_hash(tmp_path):
+    payload = sample_input()
+    old = {"product": ProductInput.model_validate(payload["product"]).model_dump(mode="json"),
+           "customer_request_id": payload["customer_request_id"],
+           "ordered_asset_hashes": assets()}
+    one, sha_one = validate_input(payload, assets())
+    two, sha_two = validate_input({**payload, "image_size": "4:5"}, assets())
+    assert one == two == old and sha_one == sha_two == digest(old)
+    store = LiveStore(tmp_path / "live.sqlite")
+    first = store.create("alice", "a" * 32, payload, assets())
+    second = store.create("alice", "a" * 32, {**payload, "image_size": "4:5"}, assets())
+    assert first["input_sha"] == second["input_sha"]
+    with pytest.raises(LiveGateError, match="LIVE_INPUT_CONFLICT"):
+        store.create("alice", "a" * 32, {**payload, "image_size": "9:16"}, assets())
+
+
+def ready_image(tmp_path, ratio):
+    pipe, jid = prepare_service(tmp_path)
+    pipe.prepare("alice", jid, {**sample_input(), "image_size": ratio})
+    provider = FakeOwner()
+    copy = pipe.text("alice", jid, provider, offline=True)
+    pipe.state.approve_copy("alice", jid, copy["generation"], copy["review_sha"])
+    pipe.prompt("alice", jid, provider, offline=True)
+    return pipe, jid
+
+
+@pytest.mark.parametrize("ratio,native,placement", [
+    ("3:4", (1152, 1536), "feed"),
+    ("4:5", (1152, 1440), "feed"),
+    ("9:16", (1152, 2048), "story"),
+])
+def test_generation_selection_and_native_result_validation(tmp_path, ratio, native, placement):
+    pipe, jid = ready_image(tmp_path, ratio)
+    owner = pipe.image_input("alice", jid)
+    if ratio == "4:5":
+        assert owner.layout_selection is None  # Historical paid request stays identical.
+    else:
+        assert owner.layout_selection.aspect_ratio == ratio
+        assert owner.layout_selection.placement == placement
+    raw = png((227, 228, 229), size=native)
+    output = BackendGeneratedImage(raw, "image/png", *native, sha256(raw).hexdigest(),
+                                  jid, owner.copy_revision, owner.copy_hash, True,
+                                  {"provider_calls": 0, "mode": "OFFLINE_MOCK_TRANSPORT"})
+    assert pipe.accept_image_result("alice", jid, output, offline=True)["state"] == "IMAGE_REVIEW_REQUIRED"
+
+
+@pytest.mark.parametrize("ratio", ["3:4", "9:16"])
+def test_generation_rejects_old_fixed_4_5_result_for_other_ratio(tmp_path, ratio):
+    pipe, jid = ready_image(tmp_path, ratio)
+    owner = pipe.image_input("alice", jid)
+    raw = png((227, 228, 229), size=(1152, 1440))
+    output = BackendGeneratedImage(raw, "image/png", 1152, 1440, sha256(raw).hexdigest(),
+                                  jid, owner.copy_revision, owner.copy_hash, True,
+                                  {"provider_calls": 0, "mode": "OFFLINE_MOCK_TRANSPORT"})
+    with pytest.raises(LiveGateError, match="OWNER_IMAGE_SIZE_INVALID"):
+        pipe.accept_image_result("alice", jid, output, offline=True)
+
+
+@pytest.mark.parametrize("ratio,native,final", [
+    ("3:4", (1152, 1536), (1080, 1440)),
+    ("4:5", (1152, 1440), (1080, 1350)),
+    ("9:16", (1152, 2048), (1080, 1920)),
+])
+def test_export_mock_owner_roundtrip_and_approved_final_size(tmp_path, ratio, native, final):
+    from src.image_generation.assets import LocalAssetStore
+    from src.image_generation.api_image_processor import ExternalImageProcessor
+    from src.image_generation.backend_adapter import BackendImageAdapter
+    from src.image_generation.openai_images import OpenAIImagesAdapter, OpenAIImagesConfig
+    from src.image_generation.provider_attempts import ProviderAttemptStore
+    from tests.demo_live.test_pipeline import layout
+
+    pipe, jid = ready_image(tmp_path, ratio)
+    calls = []
+    raw = png((219, 224, 236), size=native)
+    def handler(request):
+        message = BytesParser(policy=policy.default).parsebytes(
+            b"Content-Type: " + request.headers["content-type"].encode() + b"\r\n\r\n" + request.read())
+        fields = {part.get_param("name", header="content-disposition"):part.get_payload(decode=True)
+                  for part in message.iter_parts()
+                  if part.get_param("name", header="content-disposition") != "image[]"}
+        calls.append(fields)
+        return httpx.Response(200, json={"data":[{"b64_json":base64.b64encode(raw).decode()}]})
+    processor = ExternalImageProcessor(LocalAssetStore(tmp_path / "owner-assets"),
+        OpenAIImagesAdapter(OpenAIImagesConfig(), transport=httpx.MockTransport(handler)),
+        ProviderAttemptStore(tmp_path / "owner-attempts.sqlite"), budget_limit_usd="2", reservation_usd="1")
+    owner = BackendImageAdapter(processor, tmp_path / "owner-bindings.sqlite")
+    requested = pipe.image_input("alice", jid)
+    generated = owner.generate(requested, project_id=pipe.project_id)
+    assert calls[0]["size"].decode() == f"{native[0]}x{native[1]}"
+    assert calls[0]["n"] == b"1"
+    assert owner.generate(requested, project_id=pipe.project_id) == generated
+    assert len(calls) == 1
+    pipe.accept_image_result("alice", jid, generated, offline=True)
+    pipe.state.approve_image("alice", jid, generated.sha256)
+    if ratio != "4:5":
+        with pytest.raises(LiveGateError, match="COMPOSE_LAYOUT_RATIO_MISMATCH"):
+            pipe.compose("alice", jid, layout=layout(), font_path="unused.ttf")
+    font = Path(__file__).parents[1] / "image_generation/fixtures/fonts/NanumGothic-Regular.ttf"
+    complete = pipe.compose("alice", jid, layout=layout() if ratio == "4:5" else None, font_path=font)
+    assert complete["state"] == "COMPLETED" and len(calls) == 1
+    with Image.open(pipe.root / "outputs" / jid / "final.png") as image:
+        assert image.size == final
+    assert (pipe.root / "outputs" / jid / "caption.txt").read_text()
+
+
+@pytest.mark.parametrize("ratio,native,final", [
+    ("3:4", (1152, 1536), (1080, 1440)),
+    ("4:5", (1152, 1440), (1080, 1350)),
+    ("9:16", (1152, 2048), (1080, 1920)),
+])
+def test_export_http_snapshot_reports_validated_actual_final_size(tmp_path, ratio, native, final):
+    app, codes = setup(tmp_path)
+    with TestClient(app) as client:
+        login(client, codes["alice"])
+        jid = uploaded(client)
+        endpoint = f"/demo/api/live/jobs/{jid}"
+        accepted = client.post(endpoint + "/input", json={**sample_input(), "image_size": ratio},
+                               headers={"Origin": "http://testserver"})
+        assert accepted.status_code == 200
+        pipe = app.state.live_pipeline
+        provider = FakeOwner()
+        copy = pipe.text("alice", jid, provider, offline=True)
+        pipe.state.approve_copy("alice", jid, copy["generation"], copy["review_sha"])
+        pipe.prompt("alice", jid, provider, offline=True)
+        owner_input = pipe.image_input("alice", jid)
+        raw = png((210, 220, 230), size=native)
+        output = BackendGeneratedImage(raw, "image/png", *native, sha256(raw).hexdigest(),
+            jid, owner_input.copy_revision, owner_input.copy_hash, True, {"provider_calls": 0})
+        pipe.accept_image_result("alice", jid, output, offline=True)
+        pipe.state.approve_image("alice", jid, output.sha256)
+        font = Path(__file__).parents[1] / "image_generation/fixtures/fonts/NanumGothic-Regular.ttf"
+        pipe.compose("alice", jid, layout=None, font_path=font)
+        current = client.get(endpoint)
+        assert current.status_code == 200
+        data = current.json()
+        assert data["output_size"] == {"width": final[0], "height": final[1]}
+        assert data["image_size"] == ratio
+        assert data["mode"] == "OFFLINE_FIXTURE"  # Never publish a fake result as LIVE.
+        assert "product" not in data and "ordered_asset_hashes" not in data
