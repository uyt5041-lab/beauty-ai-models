{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "width": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "mime_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ],
          "title": "Mime Type",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "sha256",
        "width",
        "height",
        "mime_type"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "ProductInputDraft": {
      "additionalProperties": false,
      "properties": {
        "product_name": {
          "minLength": 1,
          "title": "Product Name",
          "type": "string"
        },
        "features": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Features",
          "type": "array"
        },
        "functional_status": {
          "enum": [
            "general",
            "functional",
            "unconfirmed"
          ],
          "title": "Functional Status",
          "type": "string"
        },
        "functional_categories": {
          "items": {
            "type": "string"
          },
          "title": "Functional Categories",
          "type": "array"
        }
      },
      "required": [
        "product_name",
        "features",
        "functional_status",
        "functional_categories"
      ],
      "title": "ProductInputDraft",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "draft-2026-10-22",
      "default": "draft-2026-10-22",
      "title": "Schema Version",
      "type": "string"
    },
    "product": {
      "$ref": "#/$defs/ProductInputDraft"
    },
    "product_photos": {
      "items": {
        "$ref": "#/$defs/AssetRef"
      },
      "maxItems": 5,
      "minItems": 2,
      "title": "Product Photos",
      "type": "array"
    },
    "reference_photos": {
      "items": {
        "$ref": "#/$defs/AssetRef"
      },
      "maxItems": 5,
      "title": "Reference Photos",
      "type": "array"
    },
    "ad_purpose": {
      "minLength": 1,
      "title": "Ad Purpose",
      "type": "string"
    },
    "channel": {
      "const": "instagram_feed",
      "default": "instagram_feed",
      "title": "Channel",
      "type": "string"
    },
    "final_aspect_ratio": {
      "const": "4:5",
      "default": "4:5",
      "title": "Final Aspect Ratio",
      "type": "string"
    },
    "candidate_count": {
      "const": 1,
      "default": 1,
      "title": "Candidate Count",
      "type": "integer"
    }
  },
  "required": [
    "product",
    "product_photos",
    "ad_purpose"
  ],
  "title": "ServiceIntakeDraft",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-status": "DRAFT_TEAM_UNAGREED",
  "x-origin": "proposal-unimplemented"
}
