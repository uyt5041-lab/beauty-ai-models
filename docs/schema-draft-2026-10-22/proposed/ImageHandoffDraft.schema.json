{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "width": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "mime_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ],
          "title": "Mime Type",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "sha256",
        "width",
        "height",
        "mime_type"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "CopyBundle": {
      "additionalProperties": false,
      "properties": {
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "subheadline": {
          "title": "Subheadline",
          "type": "string"
        },
        "cta": {
          "title": "Cta",
          "type": "string"
        },
        "caption": {
          "title": "Caption",
          "type": "string"
        },
        "hashtags": {
          "items": {
            "type": "string"
          },
          "title": "Hashtags",
          "type": "array"
        },
        "badges": {
          "items": {
            "type": "string"
          },
          "title": "Badges",
          "type": "array"
        }
      },
      "required": [
        "headline",
        "subheadline",
        "cta",
        "caption",
        "hashtags",
        "badges"
      ],
      "title": "CopyBundle",
      "type": "object"
    },
    "CopyReviewDraft": {
      "additionalProperties": false,
      "properties": {
        "copy_revision": {
          "minimum": 1,
          "title": "Copy Revision",
          "type": "integer"
        },
        "copy_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Copy Hash",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "copy_revision",
        "copy_hash",
        "status"
      ],
      "title": "CopyReviewDraft",
      "type": "object"
    },
    "ImagePrompt": {
      "additionalProperties": false,
      "description": "Versioned input supplied by the text service, not generated or translated here.\n\nCharacter limits bound the wire payload. A real model adapter must also check\nits tokenizer limits; ``language`` is the sender's declaration, not detection.",
      "properties": {
        "positive": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Positive",
          "type": "string"
        },
        "negative": {
          "default": "",
          "maxLength": 2000,
          "title": "Negative",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "source_revision": {
          "minimum": 1,
          "title": "Source Revision",
          "type": "integer"
        },
        "language": {
          "const": "en",
          "default": "en",
          "title": "Language",
          "type": "string"
        }
      },
      "required": [
        "positive",
        "prompt_version",
        "source_revision"
      ],
      "title": "ImagePrompt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "draft-2026-10-22",
      "default": "draft-2026-10-22",
      "title": "Schema Version",
      "type": "string"
    },
    "campaign_id": {
      "format": "uuid",
      "title": "Campaign Id",
      "type": "string"
    },
    "product_revision": {
      "minimum": 1,
      "title": "Product Revision",
      "type": "integer"
    },
    "copy_revision": {
      "minimum": 1,
      "title": "Copy Revision",
      "type": "integer"
    },
    "copy_bundle": {
      "$ref": "#/$defs/CopyBundle"
    },
    "image_prompt": {
      "$ref": "#/$defs/ImagePrompt"
    },
    "copy_review": {
      "$ref": "#/$defs/CopyReviewDraft"
    },
    "product_photos": {
      "items": {
        "$ref": "#/$defs/AssetRef"
      },
      "maxItems": 5,
      "minItems": 2,
      "title": "Product Photos",
      "type": "array"
    },
    "reference_photos": {
      "items": {
        "$ref": "#/$defs/AssetRef"
      },
      "maxItems": 5,
      "title": "Reference Photos",
      "type": "array"
    },
    "final_aspect_ratio": {
      "const": "4:5",
      "default": "4:5",
      "title": "Final Aspect Ratio",
      "type": "string"
    },
    "candidate_count": {
      "const": 1,
      "default": 1,
      "title": "Candidate Count",
      "type": "integer"
    }
  },
  "required": [
    "campaign_id",
    "product_revision",
    "copy_revision",
    "copy_bundle",
    "image_prompt",
    "copy_review",
    "product_photos"
  ],
  "title": "ImageHandoffDraft",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-status": "DRAFT_TEAM_UNAGREED",
  "x-origin": "proposal-unimplemented"
}
