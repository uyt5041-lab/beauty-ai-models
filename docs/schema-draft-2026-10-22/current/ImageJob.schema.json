{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "width": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "mime_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ],
          "title": "Mime Type",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "sha256",
        "width",
        "height",
        "mime_type"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "BackgroundResult": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "render_background",
          "default": "render_background",
          "title": "Kind",
          "type": "string"
        },
        "scene_underlay": {
          "$ref": "#/$defs/AssetRef"
        },
        "product_rgba": {
          "$ref": "#/$defs/AssetRef"
        },
        "composed_preview": {
          "$ref": "#/$defs/AssetRef"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "scene_underlay",
        "product_rgba",
        "composed_preview",
        "warnings"
      ],
      "title": "BackgroundResult",
      "type": "object"
    },
    "CutoutResult": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "cutout",
          "default": "cutout",
          "title": "Kind",
          "type": "string"
        },
        "product_rgba": {
          "$ref": "#/$defs/AssetRef"
        },
        "preserve_mask": {
          "$ref": "#/$defs/AssetRef"
        },
        "needs_manual_check": {
          "title": "Needs Manual Check",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "product_rgba",
        "preserve_mask",
        "needs_manual_check",
        "warnings"
      ],
      "title": "CutoutResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "request_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Hash",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "interrupted"
      ],
      "title": "Status",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "cutout": "#/$defs/CutoutResult",
              "render_background": "#/$defs/BackgroundResult"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CutoutResult"
            },
            {
              "$ref": "#/$defs/BackgroundResult"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "title": "Result"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    }
  },
  "required": [
    "job_id",
    "request_hash",
    "status",
    "result",
    "error_code"
  ],
  "title": "ImageJob",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-status": "DRAFT_TEAM_UNAGREED",
  "x-origin": "current-code-snapshot"
}
