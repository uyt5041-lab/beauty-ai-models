{
  "$defs": {
    "BackendCopy": {
      "additionalProperties": false,
      "properties": {
        "headline": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "subline": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subline"
        },
        "cta": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cta"
        }
      },
      "required": [
        "headline"
      ],
      "title": "BackendCopy",
      "type": "object"
    },
    "BackendImagePrompt": {
      "additionalProperties": false,
      "properties": {
        "concept": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Concept",
          "type": "string"
        },
        "prompt": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "mood": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Mood",
          "type": "array"
        }
      },
      "required": [
        "concept",
        "prompt"
      ],
      "title": "BackendImagePrompt",
      "type": "object"
    },
    "BackendSafeZone": {
      "additionalProperties": false,
      "properties": {
        "coordinate_system": {
          "const": "final_canvas_normalized",
          "default": "final_canvas_normalized",
          "title": "Coordinate System",
          "type": "string"
        },
        "left": {
          "maximum": 0.95,
          "minimum": 0.05,
          "title": "Left",
          "type": "number"
        },
        "top": {
          "maximum": 0.95,
          "minimum": 0.05,
          "title": "Top",
          "type": "number"
        },
        "right": {
          "maximum": 0.95,
          "minimum": 0.05,
          "title": "Right",
          "type": "number"
        },
        "bottom": {
          "maximum": 0.95,
          "minimum": 0.05,
          "title": "Bottom",
          "type": "number"
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "title": "BackendSafeZone",
      "type": "object"
    },
    "ProductAnalysis": {
      "additionalProperties": false,
      "properties": {
        "is_cosmetic": {
          "title": "Is Cosmetic",
          "type": "boolean"
        },
        "product_type": {
          "enum": [
            "스킨케어",
            "색조",
            "바디",
            "헤어",
            "기타"
          ],
          "title": "Product Type",
          "type": "string"
        },
        "container_type": {
          "enum": [
            "병",
            "튜브",
            "펌프",
            "스포이드",
            "자",
            "콤팩트",
            "스프레이",
            "파우치",
            "어플리케이터",
            "스틱",
            "기타"
          ],
          "title": "Container Type",
          "type": "string"
        },
        "colors": {
          "items": {
            "type": "string"
          },
          "title": "Colors",
          "type": "array"
        },
        "label_text": {
          "items": {
            "type": "string"
          },
          "title": "Label Text",
          "type": "array"
        },
        "mood": {
          "items": {
            "type": "string"
          },
          "title": "Mood",
          "type": "array"
        },
        "is_transparent": {
          "title": "Is Transparent",
          "type": "boolean"
        }
      },
      "required": [
        "is_cosmetic",
        "product_type",
        "container_type",
        "colors",
        "label_text",
        "mood",
        "is_transparent"
      ],
      "title": "ProductAnalysis",
      "type": "object"
    },
    "ProductAnalysisResult": {
      "additionalProperties": false,
      "description": "Failure defaults can say is_cosmetic=True: check success first.\n\nRaw provider errors must not be shown to users or sent to image providers.\nThis is a local receiving contract, not ownership of the text module.",
      "properties": {
        "analysis": {
          "$ref": "#/$defs/ProductAnalysis"
        },
        "analysis_succeeded": {
          "title": "Analysis Succeeded",
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "analysis",
        "analysis_succeeded"
      ],
      "title": "ProductAnalysisResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Job Id",
      "type": "string"
    },
    "copy_revision": {
      "minimum": 1,
      "title": "Copy Revision",
      "type": "integer"
    },
    "copy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Copy Hash",
      "type": "string"
    },
    "product_analysis": {
      "$ref": "#/$defs/ProductAnalysisResult"
    },
    "image_prompt": {
      "$ref": "#/$defs/BackendImagePrompt"
    },
    "ad_copy": {
      "$ref": "#/$defs/BackendCopy"
    },
    "safe_zone": {
      "anyOf": [
        {
          "$ref": "#/$defs/BackendSafeZone"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "caption": {
      "default": "",
      "maxLength": 10000,
      "title": "Caption",
      "type": "string"
    },
    "hashtags": {
      "items": {
        "maxLength": 200,
        "type": "string"
      },
      "maxItems": 50,
      "title": "Hashtags",
      "type": "array"
    },
    "product_images": {
      "items": {
        "format": "binary",
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 2,
      "title": "Product Images",
      "type": "array"
    },
    "reference_images": {
      "items": {
        "format": "binary",
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 5,
      "title": "Reference Images",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "copy_revision",
    "copy_hash",
    "product_analysis",
    "image_prompt",
    "ad_copy",
    "product_images"
  ],
  "title": "BackendImageInput",
  "type": "object"
}
