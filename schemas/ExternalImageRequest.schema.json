{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "width": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "mime_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ],
          "title": "Mime Type",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "sha256",
        "width",
        "height",
        "mime_type"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "ImagePrompt": {
      "additionalProperties": false,
      "description": "Versioned input supplied by the text service, not generated or translated here.\n\nCharacter limits bound the wire payload. A real model adapter must also check\nits tokenizer limits; ``language`` is the sender's declaration, not detection.",
      "properties": {
        "positive": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Positive",
          "type": "string"
        },
        "negative": {
          "default": "",
          "maxLength": 2000,
          "title": "Negative",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "source_revision": {
          "minimum": 1,
          "title": "Source Revision",
          "type": "integer"
        },
        "language": {
          "const": "en",
          "default": "en",
          "title": "Language",
          "type": "string"
        }
      },
      "required": [
        "positive",
        "prompt_version",
        "source_revision"
      ],
      "title": "ImagePrompt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One external image operation; input order is part of the snapshot hash.",
  "properties": {
    "kind": {
      "const": "api_image",
      "default": "api_image",
      "title": "Kind",
      "type": "string"
    },
    "operation": {
      "enum": [
        "generate",
        "edit",
        "cutout"
      ],
      "title": "Operation",
      "type": "string"
    },
    "pipeline_profile_id": {
      "const": "openai-images",
      "default": "openai-images",
      "title": "Pipeline Profile Id",
      "type": "string"
    },
    "pipeline_revision": {
      "default": "1",
      "enum": [
        "1",
        "2"
      ],
      "title": "Pipeline Revision",
      "type": "string"
    },
    "model": {
      "default": "gpt-image-2.5-sunburst-2026-09-08",
      "enum": [
        "gpt-image-2.5-sunburst-2026-09-08",
        "gpt-image-2-2026-04-21"
      ],
      "title": "Model",
      "type": "string"
    },
    "product_images": {
      "items": {
        "$ref": "#/$defs/AssetRef"
      },
      "maxItems": 5,
      "title": "Product Images",
      "type": "array"
    },
    "reference_images": {
      "items": {
        "$ref": "#/$defs/AssetRef"
      },
      "maxItems": 5,
      "title": "Reference Images",
      "type": "array"
    },
    "prompt": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImagePrompt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "width": {
      "default": 1152,
      "maximum": 3840,
      "minimum": 16,
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "default": 1440,
      "maximum": 3840,
      "minimum": 16,
      "title": "Height",
      "type": "integer"
    },
    "quality": {
      "default": "medium",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Quality",
      "type": "string"
    }
  },
  "required": [
    "operation"
  ],
  "title": "ExternalImageRequest",
  "type": "object"
}
