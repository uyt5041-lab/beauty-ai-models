{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "width": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "mime_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ],
          "title": "Mime Type",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "sha256",
        "width",
        "height",
        "mime_type"
      ],
      "title": "AssetRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "cutout",
      "default": "cutout",
      "title": "Kind",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/AssetRef"
    },
    "pipeline_profile_id": {
      "title": "Pipeline Profile Id",
      "type": "string"
    },
    "pipeline_revision": {
      "title": "Pipeline Revision",
      "type": "string"
    }
  },
  "required": [
    "source",
    "pipeline_profile_id",
    "pipeline_revision"
  ],
  "title": "CutoutRequest",
  "type": "object"
}
