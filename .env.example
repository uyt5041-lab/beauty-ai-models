# Fill these with models available to your account. They are not chosen by an end user.
# Text/review models must support Responses structured outputs; vision also needs image input.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_VISION_MODEL=
OPENAI_REVIEW_MODEL=
INFERENCE_BASE_URL=http://inference:8001
INFERENCE_INTERNAL_TOKEN=
# Local runtime. Default uses alpha upload + deterministic background template.
BEAUTY_PROJECT_ID=
BEAUTY_STORAGE_ROOT=outputs/inference
# Optional: birefnet-lite requires the models extra and explicit model_store prepare.
BEAUTY_CUTOUT_BACKEND=uploaded-alpha
BEAUTY_MODEL_ROOT=models
BEAUTY_MODEL_DEVICE=mps
TEXT_CONCURRENCY=2
# Initial tuning values, NOT measured latency guarantees:
TEXT_TOTAL_TIMEOUT_SECONDS=90
IMAGE_POLL_DEADLINE_SECONDS=120
# This value is for the GPU server to implement, not a client-side semaphore:
GPU_EXECUTORS=1
