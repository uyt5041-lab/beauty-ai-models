# Fill these with models available to your account. They are not chosen by an end user.
# Text/review models must support Responses structured outputs; vision also needs image input.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_VISION_MODEL=
OPENAI_REVIEW_MODEL=
INFERENCE_BASE_URL=http://inference:8001
INFERENCE_INTERNAL_TOKEN=
# OpenAI image wrapper: keep disabled until a separate live-test authorization.
BEAUTY_OPENAI_IMAGE_LIVE_CALLS=false
BEAUTY_OPENAI_IMAGE_TIMEOUT_SECONDS=180
# Image-only administrative reservation budget, not the shared account balance.
BEAUTY_IMAGE_BUDGET_USD=0
BEAUTY_IMAGE_RESERVATION_USD=1
# New image requests use kind=api_image, operation=generate/edit/cutout.
# Legacy local profiles below are explicit experiments, never an API fallback.
BEAUTY_PROJECT_ID=
BEAUTY_STORAGE_ROOT=outputs/inference
# Optional: birefnet-lite requires the models extra and explicit model_store prepare.
BEAUTY_CUTOUT_BACKEND=uploaded-alpha
# Optional: sdxl-inpaint requires background + models extras and sdxl_model_store prepare.
BEAUTY_BACKGROUND_BACKEND=bright-template
BEAUTY_MODEL_ROOT=models
BEAUTY_MODEL_DEVICE=mps
TEXT_CONCURRENCY=2
# Initial tuning values, NOT measured latency guarantees:
TEXT_TOTAL_TIMEOUT_SECONDS=90
IMAGE_POLL_DEADLINE_SECONDS=120
# Optional Langfuse prompt management. Project keys stay local.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# This value is for the GPU server to implement, not a client-side semaphore:
GPU_EXECUTORS=1
